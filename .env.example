# ==============================================================================
# Configuração de Envio de E-mails - Pesquisa Acadêmica Unicamp (DUIMP)
# Copie este arquivo para .env e preencha com seus dados reais:
# cp .env.example .env
# ==============================================================================

# Seu nome completo (será usado na saudação, corpo e assinatura da mensagem)
NOME_REMETENTE=Seu Nome Completo

# Seu e-mail do Gmail pessoal
EMAIL_REMETENTE=seu_email@gmail.com

# Senha de aplicativo de 16 caracteres gerada na Conta Google
# (Acesse: Conta Google > Segurança > Verificação em duas etapas > Senhas de aplicativo)
EMAIL_SENHA=xxxx xxxx xxxx xxxx

# Configurações do servidor SMTP do Gmail (não precisa alterar)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Intervalo aleatório em segundos entre cada envio (evita padrão robótico/uniforme)
DELAY_MIN_SEGUNDOS=2
DELAY_MAX_SEGUNDOS=4
